SKILLGO_ENVIRONMENT=development
SKILLGO_DATABASE_URL=sqlite:///./backend/data/skillgo.db
SKILLGO_STORAGE_ROOT=./backend/storage
SKILLGO_JWT_SECRET=replace-with-at-least-32-random-characters
SKILLGO_ACCESS_TOKEN_MINUTES=480
SKILLGO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SKILLGO_BOOTSTRAP_EMAIL=owner@example.com
SKILLGO_BOOTSTRAP_PASSWORD=change-me-before-first-start
SKILLGO_BOOTSTRAP_NAME=SkillGo Owner
SKILLGO_MODEL_BASE_URL=http://127.0.0.1:8001/v1
SKILLGO_MODEL_API_KEY=replace-with-private-model-key
SKILLGO_MODEL_NAME=your-private-model
SKILLGO_MODEL_TIMEOUT_SECONDS=120
SKILLGO_MODEL_TEMPERATURE=0.2
SKILLGO_MODEL_JSON_MODE=true
SKILLGO_MODEL_TLS_VERIFY=true
SKILLGO_CONTEXT_MAX_MESSAGES=20
SKILLGO_CONTEXT_MAX_CHARS=30000
SKILLGO_CONVERSATION_LOCK_SECONDS=180
SKILLGO_WORKSPACE_MAX_FILE_BYTES=10485760
SKILLGO_WORKSPACE_MAX_FILES=30
SKILLGO_WORKSPACE_EXTRACT_MAX_CHARS=200000
SKILLGO_WORKSPACE_CONTEXT_MAX_CHARS=40000
SKILLGO_STORAGE_RETENTION_DAYS=15
SKILLGO_STORAGE_CLEANUP_INTERVAL_SECONDS=3600
SKILLGO_STORAGE_ORPHAN_GRACE_HOURS=24
