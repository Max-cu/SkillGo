# Required: generate unique values before the first start. Never commit .env.
POSTGRES_DB=skillgo
POSTGRES_USER=skillgo
POSTGRES_PASSWORD=replace-with-a-long-random-password
SKILLGO_JWT_SECRET=replace-with-at-least-32-random-characters
SKILLGO_BOOTSTRAP_EMAIL=owner@example.com
SKILLGO_BOOTSTRAP_PASSWORD=replace-before-first-start
SKILLGO_BOOTSTRAP_NAME=SkillGo Owner

# Optional bootstrap model. Leave all three blank to configure it after login.
SKILLGO_MODEL_BASE_URL=
SKILLGO_MODEL_API_KEY=
SKILLGO_MODEL_NAME=
SKILLGO_MODEL_TIMEOUT_SECONDS=120
SKILLGO_MODEL_JSON_MODE=true
SKILLGO_MODEL_NATIVE_TOOLS=true
SKILLGO_DOCKER_GID=999
SKILLGO_MODEL_TLS_VERIFY=true
SKILLGO_SANDBOX_WORKER_ENABLED=false
SKILLGO_SANDBOX_RUNTIME=runsc
SKILLGO_SANDBOX_IMAGE=skillgo/sandbox-runtime:local
SKILLGO_SANDBOX_POLL_SECONDS=1
SKILLGO_SANDBOX_WORKER_LEASE_SECONDS=90
SKILLGO_SANDBOX_WORKER_HEARTBEAT_SECONDS=15
SKILLGO_SANDBOX_WORKER_MAX_ATTEMPTS=3
SKILLGO_SANDBOX_JOB_TIMEOUT_SECONDS=1800
SKILLGO_SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SKILLGO_SANDBOX_MAX_AGENT_TURNS=40
SKILLGO_SANDBOX_MAX_AGENT_TOOL_CALLS=160
SKILLGO_SANDBOX_MEMORY=768m
SKILLGO_SANDBOX_NANO_CPUS=1000000000
SKILLGO_SANDBOX_PIDS_LIMIT=128
SKILLGO_SANDBOX_MAX_ARTIFACT_BYTES=52428800
SKILLGO_PLATFORM_DOCUMENT_TOOLS_ENABLED=false
SKILLGO_AGENT_RUN_SUCCESS_DETAIL_DAYS=7
SKILLGO_AGENT_RUN_FAILURE_DETAIL_DAYS=30
SKILLGO_AGENT_RUN_CLEANUP_INTERVAL_SECONDS=3600
SKILLGO_CONTEXT_MAX_MESSAGES=20
SKILLGO_CONTEXT_MAX_CHARS=30000
SKILLGO_CONVERSATION_LOCK_SECONDS=180
SKILLGO_WORKSPACE_MAX_FILE_BYTES=10485760
SKILLGO_WORKSPACE_MAX_FILES=30
SKILLGO_WORKSPACE_EXTRACT_MAX_CHARS=200000
SKILLGO_WORKSPACE_CONTEXT_MAX_CHARS=40000
SKILLGO_WEB_BIND=127.0.0.1
SKILLGO_WEB_PORT=8080
SKILLGO_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

