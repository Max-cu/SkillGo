# Generate a new random value; never commit a real key.
OPENSANDBOX_API_KEY=replace-with-at-least-32-random-bytes

# Docker Desktop functional test:
OPENSANDBOX_CONFIG_FILE=./opensandbox.local.toml
POC_EXPECTED_RUNTIME=runc

# Native Linux gVisor acceptance:
# OPENSANDBOX_CONFIG_FILE=./opensandbox.gvisor.toml
# POC_EXPECTED_RUNTIME=runsc
